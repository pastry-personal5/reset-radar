{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reset-radar-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": [
      "ADMIN_TOKEN_DIGEST",
      "WRITE_TOKEN_DIGEST"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayObject"
      }
    ]
  },
  "exports": {
    "RelayObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
